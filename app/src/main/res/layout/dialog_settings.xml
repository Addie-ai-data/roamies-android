<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_dark"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roamies Settings"
        android:textColor="@color/accent_cyan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Provider"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/dialogSpinnerProvider"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_dark"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Model Name"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/dialogEtModel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_dark"
        android:textColor="@color/text_primary"
        android:hint="gemini-1.5-flash"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key (Google Gemini / OpenAI)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/dialogEtApiKey"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/bg_dark"
        android:textColor="@color/text_primary"
        android:inputType="textPassword"
        android:hint="Paste your API key here"
        android:textColorHint="@color/text_secondary"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogBtnSave"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save &amp; Connect"
        android:textColor="@color/bg_dark"
        app:backgroundTint="@color/accent_cyan"
        app:cornerRadius="8dp" />
</LinearLayout>
