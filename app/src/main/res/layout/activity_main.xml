<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- The 1:1 Roamies Canvas Stage (Interactive Buddy) -->
    <WebView
        android:id="@+id/webViewRoamie"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Bar Overlay -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="#A00B0F19"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Roamies Icon" />

        <TextView
            android:id="@+id/tvActiveBuddy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="JARVIS"
            android:textColor="@color/accent_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Size Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSize"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Size: Default"
            android:textSize="11sp"
            android:textColor="@color/text_primary"
            app:backgroundTint="#2000F5D4"
            android:layout_marginEnd="8dp" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/accent_cyan"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Character Selector Horizontal Chips -->
    <HorizontalScrollView
        android:id="@+id/characterChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:scrollbars="none"
        android:background="#800B0F19">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipJarvis"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="JARVIS (3D Sphere)"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"
                app:strokeColor="@color/accent_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipRoamie"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Roamie (Pixel)"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"
                app:strokeColor="@color/border_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAnime"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Anime Girl"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"
                app:strokeColor="@color/border_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipSarah"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sarah"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"
                app:strokeColor="@color/border_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAdrian"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Adrian"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/border_color" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Chat Interaction Bar -->
    <LinearLayout
        android:id="@+id/bottomChatBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        android:background="#D00B0F19"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Mic Button (Speech Input) -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/ic_launcher"
            android:backgroundTint="@color/card_dark"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@color/accent_cyan"
            android:layout_marginEnd="8dp"
            android:contentDescription="Voice Input" />

        <!-- Text Input Field -->
        <EditText
            android:id="@+id/etUserPrompt"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/ic_launcher"
            android:backgroundTint="@color/card_dark"
            android:hint="Talk to your Roamie..."
            android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingHorizontal="14dp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textAutoCorrect"
            android:maxLines="3" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/ic_launcher"
            android:backgroundTint="@color/accent_cyan"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/bg_dark"
            android:contentDescription="Send" />
    </LinearLayout>

</RelativeLayout>
